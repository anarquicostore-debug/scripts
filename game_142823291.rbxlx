              <Properties>
                <string name="Name">ServerSettingsScript</string>
                <ProtectedString name="Source">local v1 = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Extras"):WaitForChild("CanChangeServerSettings"):InvokeServer()
local v2 = script.Parent:WaitForChild("ServerSettings")
