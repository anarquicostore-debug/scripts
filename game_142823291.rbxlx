            <ProtectedString name="Source">local v_u_1 = script.Parent
local v_u_2 = v_u_1:WaitForChild("SettingsContainer"):WaitForChild("SettingsList")
require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("WindowService"))
local v_u_3 = game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
v_u_3:WaitForChild("Extras"):WaitForChild("GetServerSettings"):InvokeServer()
local v4 = v_u_3:WaitForChild("CustomGames"):WaitForChild("CanStartDuels"):InvokeServer()
local v_u_5 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("WindowService"))
local function v9(p_u_6) -- name: bindOptionFrame
	-- upvalues: (copy) v_u_3, (copy) v_u_2
	for _, v_u_7 in p_u_6.Options:GetChildren() do
		if not v_u_7:IsA("Frame") then
			continue
		end
		v_u_7.Button.Activated:Connect(function()
			-- upvalues: (copy) p_u_6, (ref) v_u_3, (copy) v_u_7, (ref) v_u_2
			if p_u_6.Name == "GameMode" then
				v_u_3.Extras.ChangeServerSetting:FireServer(v_u_7.Name, true)
			else
				v_u_3.Extras.ChangeServerSetting:FireServer(p_u_6.Name, v_u_7.Name)
			end
			for _, v8 in p_u_6.Options:GetChildren() do
				if not v8:IsA("Frame") then
					continue
				end
				v8.Button.Style = v8 == v_u_7 and Enum.ButtonStyle.RobloxRoundDefaultButton or Enum.ButtonStyle.RobloxRoundButton
			end
			if v_u_7.Name == "DuelMode" then
				v_u_2.Duel.Visible = true
			else
				v_u_2.Duel.Visible = false
			end
		end)
	end
end
v9(v_u_2:WaitForChild("GameMode"))
v9(v_u_2:WaitForChild("RoundTimerOverride"))
v_u_1:WaitForChild("Title"):WaitForChild("Close"):WaitForChild("Button").Activated:Connect(function()
	-- upvalues: (copy) v_u_1
	v_u_1.Visible = false
end)
v_u_2:WaitForChild("Duel"):WaitForChild("DuelSetup"):WaitForChild("Button").Activated:Connect(function()
	-- upvalues: (copy) v_u_5
	v_u_5:ToggleFrame("DuelSetup")
end)
v_u_2:WaitForChild("GameMode"):WaitForChild("Options"):WaitForChild("DuelMode").Visible = v4
v_u_5:RegisterFrame(v_u_1, "PrivateServer")</ProtectedString>
