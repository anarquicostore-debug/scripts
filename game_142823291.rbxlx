              <Properties>
                <string name="Name">KillFeed</string>
                <ProtectedString name="Source">local v_u_1 = script.Parent
local v_u_2 = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local v_u_3 = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
game.ReplicatedStorage.Remotes.Gameplay.KillEvent.OnClientEvent:Connect(function(_, _, p4, p5)
	-- upvalues: (copy) v_u_1, (copy) v_u_2, (copy) v_u_3
	for _, v6 in pairs(v_u_1:GetChildren()) do
		if not v6:IsA("Frame") then
			continue
		end
		v6.LayoutOrder = v6.LayoutOrder + 1
	end
	local v7 = script.NewEvent:Clone()
	v7.Parent = script.Parent
	if p4 then
		local _ = "+" .. p4 .. " - "
	end
	v7.EventName.Text = p5 or "Eliminated"
	game.Debris:AddItem(v7, 2)
	v7.EventName.TextTransparency = 1
	v7.EventName.TextStrokeTransparency = 1
	game:GetService("TweenService"):Create(v7.EventName, v_u_2, {
		["TextTransparency"] = 0,
		["TextStrokeTransparency"] = 0.3,
		["Position"] = nil,
		["Position"] = UDim2.new(0, 0, 0, 0)
	}):Play()
	wait(1.5)
	game:GetService("TweenService"):Create(v7.EventName, v_u_3, {
		["TextTransparency"] = 1,
		["TextStrokeTransparency"] = 1
	}):Play()
end)</ProtectedString>
