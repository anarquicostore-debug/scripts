          <Item class="LocalScript" referent="RBX135">
            <Properties>
              <string name="Name">LocalScript</string>
              <ProtectedString name="Source">local v1 = script.Parent.SheriffVictory
v1.Visible = true
local v2 = game:GetService("TweenService")
local v3 = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0)
local v4 = { v2:Create(v1.Container, v3, {
		["Size"] = UDim2.new(1, 0, 1, 0)
	}), v2:Create(v1.KnifeRight, v3, {
		["Position"] = UDim2.new(0.975, 0, 0.5, 0),
		["Rotation"] = 0
	}), v2:Create(v1.KnifeLeft, v3, {
		["Position"] = UDim2.new(0.025, 0, 0.5, 0),
		["Rotation"] = 0
	}) }
for _, v5 in pairs(v4) do
	v5:Play()
end</ProtectedString>
            </Properties>
