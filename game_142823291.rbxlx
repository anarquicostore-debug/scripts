            <string name="Name">ModeScript</string>
            <ProtectedString name="Source">local v1 = game:GetService("TeleportService")
local v_u_2 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("WindowService"))
local v_u_3 = game.ReplicatedStorage.Remotes.Extras.RequestTeleport
local v_u_4 = require(game.ReplicatedStorage.Modules.FriendsModule)
local v_u_5 = script.Parent
local v_u_6 = v_u_5:WaitForChild("Container"):WaitForChild("Modes")
local v_u_7 = v_u_5.TeleportInfo
local v_u_8 = v_u_5.Overlay
local v_u_9 = script:WaitForChild("ModeFrame")
local v_u_10 = script:WaitForChild("ModeOverlay")
local v_u_11 = v_u_10:WaitForChild("ModeInfo"):WaitForChild("ModeList"):WaitForChild("ListItem")
v_u_11.Parent = script
local v_u_12 = require(game:GetService("ReplicatedStorage"):WaitForChild("Database"):WaitForChild("Sync")).GameModes
local function v_u_24(p13) -- name: updateFrame
	-- upvalues: (copy) v_u_4, (copy) v_u_12, (copy) v_u_8
	local v14 = p13.Name
	local v15 = p13.Info
	local v16 = v_u_4:GetFriendsOnline()
	local v17 = v_u_12[v14].PlaceID
	local v18 = 0
	for _, v19 in v16 do
		if v19.PlaceId ~= v17 then
			continue
		end
		v18 = v18 + 1
	end
	local v20 = v18 .. " " .. (v18 == 1 and "Friend" or "Friends") .. " Online"
	v15.PlayerCount.Visible = v_u_12[v14].PlayerCount &gt; 0
	v15.FriendsPlaying.Visible = v18 &gt; 0
	v15.FriendsPlaying.TextLabel.Text = v20
	local v21 = v15.Popular
	local v22
	if v14 == "Standard" and v15.PlayerCount.Visible == false then
		v22 = v15.FriendsPlaying.Visible == false
	else
		v22 = false
	end
	v21.Visible = v22
	local v23 = v_u_8.Container:FindFirstChild(v14)
	v23.FriendsPlaying.Visible = v18 &gt; 0
	v23.FriendsPlaying.TextLabel.Text = v20
	v23.Actions.Friends.Visible = v18 &gt; 0
end
v1.TeleportInitFailed:Connect(function()
	-- upvalues: (copy) v_u_7
	v_u_7.Visible = false
end)
v_u_8.Close.Button.Activated:Connect(function()
	-- upvalues: (copy) v_u_8
	v_u_8.Visible = false
end)
v_u_2:RegisterFrame(v_u_5, "ModeBrowser", function()
	-- upvalues: (copy) v_u_6, (copy) v_u_24
	for _, v25 in v_u_6:GetChildren() do
		if not v25:IsA("Frame") then
			continue
		end
		local _ = v25.Name
		v_u_24(v25)
	end
end)
v_u_5:WaitForChild("Container"):WaitForChild("Title"):WaitForChild("Close"):WaitForChild("Button").Activated:Connect(function()
	-- upvalues: (copy) v_u_5
	v_u_5.Visible = false
end)
os.clock();
(function() -- name: setupModes
	-- upvalues: (copy) v_u_12, (copy) v_u_9, (copy) v_u_10, (copy) v_u_11, (copy) v_u_8, (copy) v_u_24, (copy) v_u_7, (copy) v_u_3, (copy) v_u_2, (copy) v_u_6
	for v_u_26, v_u_27 in v_u_12 do
		if v_u_27.Hidden then
			continue
		end
		local v28 = v_u_9:Clone()
		v28.Name = v_u_26
		v28.Info.ModeName.TextLabel.Text = v_u_27.DisplayName
		v28.Info.ModeIcon.ImageLabel.Image = v_u_27.Image
		v28.Info.ModeIcon.Limited.Visible = v_u_27.LimitedTime == true
		v28.LayoutOrder = v_u_27.Order
		local v_u_29 = v_u_10:Clone()
		v_u_29.ModeName.Text = v_u_27.DisplayName
		v_u_29.ModeInfo.ModeIcon.ImageLabel.Image = v_u_27.Image
		for v30, v31 in v_u_27.Description do
			local v32 = v_u_11:Clone()
			v32.Text = v31
			v32.LayoutOrder = v30
			v32.Parent = v_u_29.ModeInfo.ModeList
		end
		v_u_29.Name = v_u_26
		v_u_29.Parent = v_u_8.Container
		v_u_24(v28)
		v28.Info.ModeIcon.CurrentServer.Visible = v_u_27.PlaceID == game.PlaceId
		v28.Button.Activated:Connect(function()
			-- upvalues: (ref) v_u_8, (copy) v_u_29
			if not v_u_8.Visible then
				for _, v33 in v_u_8.Container:GetChildren() do
					if not v33:IsA("Frame") or v33.Name == "Close" then
						continue
					end
					v33.Visible = v33 == v_u_29
				end
				v_u_8.Visible = true
			end
		end)
		v_u_29.Actions.Play.Activated:Connect(function()
			-- upvalues: (copy) v_u_27, (ref) v_u_7, (ref) v_u_3, (copy) v_u_26
			local _ = v_u_27.PlaceID
			v_u_7.Visible = true
			v_u_3:InvokeServer(v_u_26)
		end)
		v_u_29.Actions.Friends.Activated:Connect(function()
			-- upvalues: (ref) v_u_2
			v_u_2:ToggleFrame("FriendsOnline")
		end)
		v28.Parent = v_u_6
	end
end)()
task.spawn(function()
	-- upvalues: (copy) v_u_6, (copy) v_u_24
	while true do
		task.wait(10)
		for _, v34 in v_u_6:GetChildren() do
			if not v34:IsA("Frame") then
				continue
			end
			v_u_24(v34)
		end
	end
end)</ProtectedString>
