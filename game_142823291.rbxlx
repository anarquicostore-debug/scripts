          <Item class="LocalScript" referent="RBX23537">
            <Properties>
              <string name="Name">Trading</string>
              <ProtectedString name="Source">local v1 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("ProfileData"))
local v_u_2 = game:GetService("PolicyService")
local v_u_3 = game.Players.LocalPlayer
local v4 = script.Parent.Parent.Game
local v_u_5 = require(game.ReplicatedStorage.Modules.TradeModule)
local v6 = require(game.ReplicatedStorage.Modules.LevelModule)
local v_u_7 = game:GetService("ReplicatedStorage"):WaitForChild("Trade")
local v8, v9 = pcall(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_3
	return v_u_2:GetPolicyInfoForPlayerAsync(v_u_3)
end)
local v10 = v6.GetLevel(v1.NewXP) &gt;= 10 and true or v1.Prestige &gt; 0
if v8 then
	if not v9.IsPaidItemTradingAllowed then
		v4.Leaderboard.Inspect.Trade.Visible = false
		v_u_5.RequestsEnabled = false
		return "Trading Not Allowed"
	end
else
	warn("PolicyService error: " .. v9)
end
if not v10 then
	v4.Leaderboard.Inspect.Trade.Visible = false
	v_u_5.RequestsEnabled = false
end
local v11 = v4.Leaderboard
local _ = v11.Inspect
local v_u_12 = v11.Container.TradeRequest
local v_u_13 = game.Players.LocalPlayer.PlayerGui.TradeGUI
v_u_5.GUI.RequestFrame = v_u_12
v_u_5.GUI.TradeGUI = game.Players.LocalPlayer.PlayerGui.TradeGUI
v_u_5.GUI.Actions = v_u_13.Container.Trade.Actions
v_u_5.GUI.YourOffer = v_u_13.Container.Trade.YourOffer
v_u_5.GUI.TheirOffer = v_u_13.Container.Trade.TheirOffer
local v14, v15 = game.ReplicatedStorage.Trade.GetTradeStatus:InvokeServer()
v_u_5.UpdateTradeRequestWindow(v14, v15)
v_u_5.ConnectRequestWindow()
v_u_5.ConnectActions()
v_u_5.ConnectTabButtons()
local v_u_16 = v4.Leaderboard.Container.ToggleRequests
v_u_16.On.Visible = v_u_5.RequestsEnabled
v_u_16.Off.Visible = not v_u_5.RequestsEnabled
v_u_16.On.Activated:Connect(function()
	-- upvalues: (copy) v_u_16, (copy) v_u_5, (copy) v_u_7, (copy) v_u_12
	v_u_16.On.Visible = false
	v_u_16.Off.Visible = true
	v_u_5.RequestsEnabled = false
	game.ReplicatedStorage.Trade.DeclineRequest:FireServer()
	v_u_7.SetRequestsEnabled:FireServer(false)
	v_u_12.Visible = false
end)
v_u_16.Off.Activated:Connect(function()
	-- upvalues: (copy) v_u_16, (copy) v_u_7, (copy) v_u_5
	v_u_16.On.Visible = true
	v_u_16.Off.Visible = false
	v_u_7.SetRequestsEnabled:FireServer(true)
	v_u_5.RequestsEnabled = true
end)
v_u_13.Changed:Connect(function()
	-- upvalues: (copy) v_u_13
	v_u_13.ClickBlocker.Visible = v_u_13.Enabled
end)
local v_u_17 = game.Players.LocalPlayer
v_u_17.Changed:connect(function()
	-- upvalues: (copy) v_u_13, (copy) v_u_17
	v_u_13.Container.Visible = v_u_17:GetAttribute("PerformingTrade") ~= true
	v_u_13.Processing.Visible = v_u_17:GetAttribute("PerformingTrade") == true
end)</ProtectedString>
