                        <Properties>
                          <string name="Name">Featured</string>
                          <ProtectedString name="Source">local v_u_1 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("WindowService"))
local v_u_2 = require(game:GetService("ReplicatedStorage"):WaitForChild("SharedServices"):WaitForChild("EventInfoService"))
local v_u_3 = script.Parent:WaitForChild("CoverPhoto")
local v_u_4 = script.Parent:WaitForChild("EventPhoto")
local v_u_5 = script.Parent:WaitForChild("BasePhoto")
local v_u_6 = nil
local function v8() -- name: onInitialize
	-- upvalues: (copy) v_u_2, (copy) v_u_4, (copy) v_u_5, (copy) v_u_3, (ref) v_u_6, (copy) v_u_1
	local v7 = v_u_2:GetMainEvent()
	if v7 and (v7.EventStartInfo and (v7.EventStartInfo.UI and v7.EventStartInfo.UI.ShopCover)) then
		v_u_4.Image = v7.EventStartInfo.UI.ShopCover
		v_u_4.Visible = true
		v_u_5.Visible = false
		v_u_3.Visible = false
		if v_u_6 then
			v_u_6:Disconnect()
		end
		v_u_6 = v_u_4:WaitForChild("BuyItem").Activated:Connect(function()
			-- upvalues: (ref) v_u_1
			v_u_1:ToggleFrame("CurrentEvent")
		end)
		return
	elseif v_u_3.Visible then
		v_u_4.Visible = false
		v_u_5.Visible = false
		v_u_3:WaitForChild("BuyItem").Activated:Connect(function()
			-- upvalues: (ref) v_u_1
			v_u_1:ToggleFrame(nil)
		end)
	else
		if v_u_6 then
			v_u_6:Disconnect()
			v_u_6 = nil
		end
		v_u_4.Visible = false
		v_u_3.Visible = false
		v_u_5.Visible = true
	end
end
v_u_2:OnEventStarted(v8)
v_u_2:OnEventEnded(v8)
