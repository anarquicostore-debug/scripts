                  <ProtectedString name="Source">local v_u_1 = require(game:GetService("ReplicatedStorage"):WaitForChild("SharedServices"):WaitForChild("EventInfoService"))
local v_u_2 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("WindowService"))
local v_u_3 = script.Parent
local v_u_4 = v_u_3:WaitForChild("CenterIcon")
