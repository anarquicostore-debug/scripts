		if v_u_8 &gt; 1 then
			v_u_4.Container.Claim.Text = "Claim (" .. v_u_7 .. "/" .. v_u_8 .. ")"
		else
			v_u_4.Container.Claim.Text = "Claim"
		end
		v_u_13()
	end
end)
game.ReplicatedStorage:WaitForChild("ItemGift").OnClientEvent:connect(function(p20, p21)
	_G.NewItem(p20, "You Got...", nil, p21)
end)</ProtectedString>
