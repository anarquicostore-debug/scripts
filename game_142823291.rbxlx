            <Item class="LocalScript" referent="RBX26225">
              <Properties>
                <string name="Name">MusicScript</string>
                <ProtectedString name="Source">local v1 = script.Parent:WaitForChild("Mute")
local v_u_2 = game:GetService("SoundService"):WaitForChild("Music")
game:GetService("ReplicatedStorage"):WaitForChild("Remotes")
require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("AudioService"))
local v_u_3 = v1:WaitForChild("MutedIcon")
local v_u_4 = v1:WaitForChild("UnmutedIcon")
v_u_3.Visible = v_u_2.Volume &lt;= 0
v_u_4.Visible = v_u_2.Volume &gt; 0
v1:WaitForChild("Button").Activated:Connect(function() -- name: onMuteToggled
	-- upvalues: (copy) v_u_2, (copy) v_u_3, (copy) v_u_4
	if v_u_2.Volume &gt; 0 then
		v_u_2.Volume = 0
	else
		v_u_2.Volume = 1
	end
	v_u_3.Visible = v_u_2.Volume &lt;= 0
	v_u_4.Visible = v_u_2.Volume &gt; 0
end)</ProtectedString>
              </Properties>
            </Item>
