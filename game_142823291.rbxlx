          <Item class="LocalScript" referent="RBX21803">
            <Properties>
              <string name="Name">CoinBagScript</string>
              <ProtectedString name="Source">local v1 = script.Parent.CoinIcon
if workspace:GetAttribute("isChristmas") then
	v1.Image = "rbxassetid://4521639303"
	return
elseif workspace:GetAttribute("isValentines") then
	v1.Image = "http://www.roblox.com/asset/?id=12349622103"
	return
elseif workspace:GetAttribute("isEaster") then
	v1.Image = "http://www.roblox.com/asset/?id=12966773156"
	return
elseif workspace:GetAttribute("isHalloween") then
	v1.Image = "http://www.roblox.com/asset/?id=15056209964"
else
	v1.Image = "rbxassetid://3150319038"
end</ProtectedString>
            </Properties>
          </Item>
