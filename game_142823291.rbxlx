              <string name="Name">CoinBagContainerScript</string>
              <ProtectedString name="Source">local v_u_1 = script.Parent.Container
local v_u_2 = game:GetService("TweenService")
local v3 = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Gameplay"):WaitForChild("CoinCollected")
local v4 = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Gameplay"):WaitForChild("CoinsStarted")
local v_u_5 = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0)
local v_u_6 = TweenInfo.new(1.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0)
local v_u_7 = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, false, 0)
local function v_u_10(p8) -- name: PlayBagFullAnimation
	-- upvalues: (copy) v_u_2, (copy) v_u_5, (copy) v_u_6, (copy) v_u_7
	local v9 = script.FullBagNotification:Clone()
	v9.Text = string.upper(p8) .. " FULL!"
	v9.Position = UDim2.new(0.5, 0, 1.15, 0)
	v9.Rotation = -3
	v9.Visible = true
	v9.Parent = script.Parent
	game.Debris:AddItem(v9, 3)
	v_u_2:Create(v9, v_u_5, {
		["Position"] = UDim2.new(0.5, 0, 0.8, 0)
	}):Play()
	task.wait(0.5)
	v_u_2:Create(v9, v_u_6, {
		["Rotation"] = 3
	}):Play()
	task.wait(1.5)
	v_u_2:Create(v9, v_u_7, {
		["Position"] = UDim2.new(0.5, 0, 1.15, 0)
	}):Play()
end
local function v16(p11, p12, p13, _) -- name: onCoinCollected
	-- upvalues: (copy) v_u_1, (copy) v_u_10
	local v14 = v_u_1:FindFirstChild(p11)
	if v14 then
		local v15 = p13 &lt;= p12
		v14.CurrencyFrame.Icon.Coins.Text = p12
		if v15 then
			v14.EmptyBagIcon.Visible = false
			v14.FullBagIcon.Visible = true
			v14.Full.Visible = true
			v_u_10(v14:GetAttribute("BagName"))
		end
	end
end
local function v20(p17) -- name: onCoinsStarted
	-- upvalues: (copy) v_u_1
	local v18 = v_u_1:GetChildren()
	for _, v19 in pairs(v18) do
		if not v19:IsA("Frame") then
			continue
		end
		v19.Visible = p17[v19.Name] ~= nil
	end
end
for _, v21 in pairs(v_u_1:GetChildren()) do
	if not v21:IsA("Frame") then
		continue
	end
	v21.Visible = false
end
require(game:GetService("ReplicatedStorage"):WaitForChild("SharedServices"):WaitForChild("EventInfoService"))
v3.OnClientEvent:Connect(v16)
v4.OnClientEvent:Connect(v20)</ProtectedString>
