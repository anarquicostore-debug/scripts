          <Item class="LocalScript" referent="RBX23538">
            <Properties>
              <string name="Name">NewItem</string>
              <ProtectedString name="Source">local v_u_1 = script.Parent.Parent.Game
local v_u_2 = require(game.ReplicatedStorage.Modules.ItemModule)
local v_u_3 = require(game:GetService("ReplicatedStorage"):WaitForChild("Database"):WaitForChild("Sync"))
local v_u_4 = v_u_1.NewItem
local v_u_5 = nil
local v_u_6 = {}
game.Lighting.NewItemBlur.Enabled = false
local v_u_7 = 1
local v_u_8 = 1
local function v_u_13() -- name: ShowItem
	-- upvalues: (copy) v_u_6, (copy) v_u_3, (copy) v_u_2, (copy) v_u_4, (ref) v_u_5
	local v9 = v_u_6[1]
	local v10 = v_u_3[v9.Type][v9.ItemName]
	local v11 = v9.Amount or nil
	v_u_2.DisplayItem(v_u_4.Container.NewItem, v10, v11)
	local v12 = v_u_3.Rarities[v10.Rarity].Color
	v_u_4.Container.Starburst.ImageColor3 = Color3.fromRGB(v12.r, v12.g, v12.b) or Color3.new(1, 1, 1)
	v_u_4.Container.Title.Text = v9.TitleText
	if v9.LFrame then
		v_u_5 = v9.LFrame
		v_u_5.Visible = false
	end
	game.Lighting.NewItemBlur.Enabled = true
	v_u_4.Visible = true
end
function _G.NewItem(p14, p15, p16, p17, p18)
	-- upvalues: (copy) v_u_6, (copy) v_u_4, (ref) v_u_7, (ref) v_u_8, (copy) v_u_13
	local v19 = v_u_6
	table.insert(v19, {
		["ItemName"] = p14,
		["TitleText"] = p15 or "You Got...",
		["LFrame"] = p16,
		["Type"] = p17 or "Weapons",
		["Amount"] = p18
	})
	if v_u_4.Visible then
		v_u_8 = v_u_8 + 1
	else
		v_u_7 = 1
		v_u_8 = #v_u_6
		v_u_13()
	end
	if v_u_8 &gt; 1 then
		v_u_4.Container.Claim.Text = "Claim (" .. v_u_7 .. "/" .. v_u_8 .. ")"
	else
		v_u_4.Container.Claim.Text = "Claim"
	end
end
v_u_4.Container.Claim.MouseButton1Click:connect(function()
	-- upvalues: (copy) v_u_2, (copy) v_u_4, (copy) v_u_1, (copy) v_u_6, (ref) v_u_7, (ref) v_u_8, (copy) v_u_13, (ref) v_u_5
	v_u_2.AnimateItemIconIntoInventory(v_u_4.Container.NewItem.Container.Icon, v_u_1.Dock.Inventory, v_u_1)
