	-- upvalues: (copy) v_u_1, (copy) v_u_3, (copy) v_u_4, (copy) v_u_2
	local v5 = v_u_1:GetMainEvent()
	if v5.EventStartInfo.UI and v5.EventStartInfo.UI.ShopButton then
		v_u_3.Visible = true
		v_u_4.Image = v5.EventStartInfo.UI.ShopButton
		v_u_4.Visible = true
		if v5.EventStartInfo.UI.PrimaryColor then
			v_u_3:WaitForChild("Background").BackgroundColor3 = v5.EventStartInfo.UI.PrimaryColor
		else
			v_u_3:WaitForChild("Background").BackgroundColor3 = Color3.fromRGB(0, 0, 0)
			v_u_3:WaitForChild("Background").Transparency = 0.6
		end
		v_u_3.Activated:Connect(function()
			-- upvalues: (ref) v_u_2
			v_u_2:ToggleFrame("CurrentEvent")
		end)
	end
end)
v_u_1:OnEventEnded(function(p6)
	-- upvalues: (copy) v_u_3
	if p6.Priority == "Main" then
