              <ProtectedString name="Source">local v_u_1 = require(game:GetService("ReplicatedStorage"):WaitForChild("Modules"):WaitForChild("SpectateService"))
local v2 = script.Parent.Parent:WaitForChild("Lobby")
local v3 = v2:WaitForChild("Dock"):WaitForChild("Spectate")
local v_u_4 = v2:WaitForChild("Screens"):WaitForChild("Spectate")
v_u_1.SpectateStarted.Event:Connect(function() -- name: onSpectateStarted
	-- upvalues: (copy) v_u_4
	v_u_4.Visible = true
end)
v_u_1.SpectateCancelled.Event:Connect(function() -- name: onSpectateCancelled
	-- upvalues: (copy) v_u_4
	v_u_4.Visible = false
end)
v_u_1.SpectateTargetChanged.Event:Connect(function(p5) -- name: onSpectateTargetChanged
	-- upvalues: (copy) v_u_4
	v_u_4.PlayerName.Text = p5.Name
end)
v_u_4.Right.Activated:Connect(function()
	-- upvalues: (copy) v_u_1
	v_u_1:NavigateSpectate(1)
end)
v_u_4.Left.Activated:Connect(function()
	-- upvalues: (copy) v_u_1
	v_u_1:NavigateSpectate(-1)
end)
v3.Activated:Connect(function() -- name: onSpectateButtonActivated
	-- upvalues: (copy) v_u_1
	v_u_1:ToggleSpectate()
end)
_G.CancelSpectate = v_u_1.CancelSpectate</ProtectedString>
