v_u_3.Visible = v_u_2.Volume &lt;= 0
v_u_4.Visible = v_u_2.Volume &gt; 0
v1:WaitForChild("Button").Activated:Connect(function() -- name: onMuteToggled
	-- upvalues: (copy) v_u_2, (copy) v_u_3, (copy) v_u_4
	if v_u_2.Volume &gt; 0 then
